# RunixOS uses custom library extensions:
#   .rdl = RunixOS Dynamic Library (shared)
#   .ral = RunixOS Archive Library (static)
shared-lib-ext = .rdl
static-lib-ext = .ral

# RunixOS has no separate sbin - everything goes to bindir.
sbindir = $(bindir)
rootsbindir = $(bindir)

# RunixOS renames ld.so.conf -> LibKit.conf. Only ldconfig.c consumes LD_SO_CONF,
# so scope the define to that file instead of every object in the tree.
# ld.so.cache -> LibKit.cache is handled via sysdeps/unix/sysv/runixos/dl-cache.h.
CFLAGS-ldconfig.c += -DLD_SO_CONF='"$(sysconfdir)/LibKit.conf"'
